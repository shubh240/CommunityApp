{
  "name": "communityappdevelopment",
  "version": "1.0.0",
  "description": "Community AppDevelopment Backend",
  "main": "app.ts",
  "scripts": {
    "dev:api": "cross-env NODE_ENV=development SERVE=api nodemon src/server.ts",
    "dev:web": "cross-env NODE_ENV=development SERVE=web nodemon src/server.ts",
    "start:api": "npm run build && cross-env NODE_ENV=production SERVE=api node dist/server.js",
    "start:web": "npm run build && cross-env NODE_ENV=production SERVE=web PORT=8001 node dist/server.js",
    "dist": "cross-env NODE_ENV=production node dist/server.js",
    "build": "rimraf dist && swc src -d dist --source-maps --copy-files && npm run build:tsc",
    "build:tsc": "cross-env NODE_OPTIONS='--max-old-space-size=8192' tsc && tsc-alias",
    "script:adminMigration": "ts-node src/scripts/adminMigration.ts",
    "script:helpMigration": "ts-node src/scripts/helpMigration.ts",
    "script:dirtyHelpMigration": "ts-node src/scripts/dirtyHelpMigration.ts",
    "script:userMigration": "ts-node src/scripts/userMigration.ts",
    "script:dirtyUserMigration": "ts-node src/scripts/dirtyUserMigration.ts",
    "script:fcmMigration": "ts-node src/scripts/fcmMigration.ts",
    "script:versionMigration": "ts-node src/scripts/versionMigration.ts",
    "seed:oldState": "ts-node src/seeders/oldState.seeder.ts",
    "seed:state": "ts-node src/seeders/state.seeder.ts",
    "seed:oldDistrict": "ts-node src/seeders/oldDistrict.seeder.ts",
    "seed:district": "ts-node src/seeders/district.seeder.ts",
    "seed:block": "ts-node src/seeders/block.seeder.ts",
    "push": "ts-node src/scripts/pushNotification.ts"
  },
  "author": "Aditya Panchal",
  "license": "ISC",
  "dependencies": {
    "aws-sdk": "^2.1693.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bson": "^6.10.4",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.2",
    "envalid": "^8.1.0",
    "express": "^5.1.0",
    "express-query-parser": "^1.3.3",
    "firebase-admin": "^13.5.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "nodemon": "^3.1.10",
    "request": "^2.88.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "twilio": "^5.11.1",
    "typescript": "^5.9.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/morgan": "^1.9.10",
    "@types/request": "^2.48.13"
  }
}